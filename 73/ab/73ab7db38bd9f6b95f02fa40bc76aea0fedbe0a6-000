W = P('roof_width'); PW = P('roof_porch_width'); SC = P('roof_tile_scale'); K = P('roof_tile_tilt')
L = TL * SC; pitch = L * (1.0 - P('tile_overlap_length')); px = TW * SC
geo.addAttrib(hou.attribType.Point, 'N', (0.0, 0.0, 1.0))
