geo.addAttrib(hou.attribType.Point, 'part', '')
s_min = P('ridge_width') * 0.35
def columns(width):
    n = int(width / px)
    return [(c - (n - 1) / 2.0) * px for c in range(n)]
def lay(side, a_eave, width, s_from=None, part='field'):
    cur = RoofCurve(side, max(a_eave, P('roof_porch_run') if side > 0 else a_eave))
