# 260 mm across, a 33 mm lip block on the free edge, a 171 mm pan that sags only 15 mm, and a round
# cover roll of 28 mm radius that closes the 260 mm. The sag is SHALLOW : that is the angle of the ref.
# FR : le bac ne creuse que 15 mm sur 171, c est ce qui donne l angle juste.
xL = -TW / 2.0
half = math.sqrt(max(1e-9, RR * RR - (TT / 2.0) ** 2))
xR = TW / 2.0 - RR - half                # the roll closes exactly on the nominal width
xP0 = xL + LIPW                          # the pan starts at the right face of the lip block
span = xR - xP0


def pan_y(u):                            # u = 0 at the lip, 1 at the roll ; trough at TR
    if u < TR:
        return TC * ((TR - u) / TR) ** 2
    return TC * RATIO * ((u - TR) / (1.0 - TR)) ** 2


def extrude(sect, z0, z1, name):
    # the section must be wound like Houdini's own box SOP, otherwise the solid is inside out
    # and a boolean union silently turns into an intersection.
    # FR : meme sens que le box SOP, sinon le boolean detruit tout en silence.
    area = 0.0
    for i in range(len(sect)):
        x0_, y0_ = sect[i]; x1_, y1_ = sect[(i + 1) % len(sect)]
        area += x0_ * y1_ - x1_ * y0_
    if area > 0:
        sect = list(reversed(sect))
    a, b = [], []
    for x, y in sect:
        q = geo.createPoint(); q.setPosition((x, y, z0)); a.append(q)
        q = geo.createPoint(); q.setPosition((x, y, z1)); b.append(q)
    n = len(sect)
    for i in range(n):
        j = (i + 1) % n
        pl([a[i], a[j], b[j], b[i]], name)
    pl(list(reversed(a)), name)
    pl(b, name)


# ONE closed cross section carries the lip, the pan and the cover roll, so the tile comes out of the
# extrusion already welded : no boolean, no floating piece.
yT0 = pan_y(0.0); yB0 = yT0 - TT
notch_w = LIPW * 0.45; notch_h = TT * 0.055   # the small notch cut in the top left of the lip block
cy = pan_y(1.0) - TT / 2.0                    # the roll circle passes through both ends of the pan
cx = xR + half
