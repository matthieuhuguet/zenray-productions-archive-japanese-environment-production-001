def curved_beam(half_len, y_bottom, thick, depth, rise, name, n=24, slant=0.0):
    # beam whose top and bottom follow y + rise * (|x| / half)^4.5 ; ends cut on a slant
    pts = []
    for i in range(n + 1):
        x = -half_len + 2 * half_len * i / float(n)
        lift = rise * (abs(x) / half_len) ** 4.5          # flat in the middle, rising at the ends
        ext = slant * (abs(x) / half_len) ** 6          # the top overhangs a little at the very ends
        ring = []
        for (dx, yy, zz) in ((0, y_bottom, -depth / 2), (0, y_bottom, depth / 2), (ext, y_bottom + thick, depth / 2), (ext, y_bottom + thick, -depth / 2)):
            q = geo.createPoint(); q.setPosition((x, yy + lift, zz)); ring.append(q)
        pts.append(ring)
    for i in range(n):
        r0, r1 = pts[i], pts[i + 1]
        for j in range(4):
            jj = (j + 1) % 4
            pl([r0[j], r0[jj], r1[jj], r1[j]], name)
    pl(pts[0], name); pl(list(reversed(pts[-1])), name)
