    tidy(scene)
    g = out.geometry()
    return {'points': g.intrinsicValue('pointcount'), 'prims': g.intrinsicValue('primitivecount'),
            'components': sorted(c.name() for c in scene.children() if c.name().startswith('Component_')),
            'errors': [n.path() for n in scene.allSubChildren() if n.errors()]}
