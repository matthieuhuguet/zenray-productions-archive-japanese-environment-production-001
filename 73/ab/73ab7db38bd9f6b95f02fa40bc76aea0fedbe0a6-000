HELPERS = r'''
import math
node = hou.pwd()
geo = node.geometry()
geo.addAttrib(hou.attribType.Prim, 'name', '')
_up = node.parent()                      # the nearest ancestor that carries the parameter wins,
while _up is not None:                   # so the same code runs in JapanScene or inside the tile HDA
    if _up.parm('tile_width') is not None or _up.name() == 'JapanScene':
        break
    _up = _up.parent()
_scene = _up
def P(n):
    n_ = _scene
    while n_ is not None and n_.parm(n) is None:
        n_ = n_.parent()
    return (n_ or _scene).evalParm(n)
def quad(pts, name):
    poly = geo.createPolygon()
    for p in pts:
        pt = geo.createPoint(); pt.setPosition(p); poly.addVertex(pt)
    poly.setAttribValue('name', name)
def box8(c, name):
    # 8 shared points : every box is a closed solid (clean booleans, no fuse needed)
    pts = []
    for q in c:
        pt = geo.createPoint(); pt.setPosition(q); pts.append(pt)
    # winding checked against Houdini's own box SOP : that is the orientation booleans expect.
    for f in ((0, 3, 2, 1), (4, 5, 6, 7), (0, 1, 5, 4), (1, 2, 6, 5), (2, 3, 7, 6), (3, 0, 4, 7)):
        poly = geo.createPolygon()
        for i in f:
            poly.addVertex(pts[i])
        poly.setAttribValue('name', name)
def aabb(x0, y0, z0, x1, y1, z1, name):
    x0, x1 = min(x0, x1), max(x0, x1); y0, y1 = min(y0, y1), max(y0, y1); z0, z1 = min(z0, z1), max(z0, z1)
    box8([(x0, y0, z0), (x1, y0, z0), (x1, y0, z1), (x0, y0, z1),
          (x0, y1, z0), (x1, y1, z0), (x1, y1, z1), (x0, y1, z1)], name)
def frame(axis):
    a = hou.Vector3(axis).normalized()
    up = hou.Vector3(0, 1, 0) if abs(a[1]) < 0.9 else hou.Vector3(1, 0, 0)
    u = a.cross(up).normalized(); v = a.cross(u).normalized()
    return a, u, v
def tube(p0, p1, r, name, sides=16, cap0=False, cap1=False):
    p0 = hou.Vector3(p0); p1 = hou.Vector3(p1)
    a, u, v = frame(p1 - p0)
    ring = lambda c: [c + (u * math.cos(2 * math.pi * i / sides) + v * math.sin(2 * math.pi * i / sides)) * r for i in range(sides)]
    r0, r1 = ring(p0), ring(p1)
    for i in range(sides):
        j = (i + 1) % sides
        quad([r0[i], r0[j], r1[j], r1[i]], name)
    if cap0:
        quad(list(reversed(r0)), name)
    if cap1:
        quad(r1, name)
'''


