# Component_Roof_09 shared frame. Tile module : pan curved across X, running along Z, cover roll on +X edge.
V3 = hou.Vector3
geo.addAttrib(hou.attribType.Prim, 'Cd', (0.72, 0.72, 0.71))
def paint(col, k=0):
    for pr in geo.prims()[k:]:
        pr.setAttribValue('Cd', col)
def pl(pts, name):
    q = geo.createPolygon()
    for x in pts:
        q.addVertex(x)
    q.setAttribValue('name', name)
def cylx(c, axis, r, h, name, seg=20, cap=True):
    c = V3(c); axis = V3(axis).normalized(); _, u, v = frame(axis)
    r0, r1 = [], []
    for j in range(seg):
        a = 2 * math.pi * j / seg
        d = u * math.cos(a) + v * math.sin(a)
        q = geo.createPoint(); q.setPosition(c + d * r); r0.append(q)
        q = geo.createPoint(); q.setPosition(c + d * r + axis * h); r1.append(q)
    for j in range(seg):
        jj = (j + 1) % seg
        pl([r1[j], r1[jj], r0[jj], r0[j]], name)
    if cap:
        pl(r0, name); pl(list(reversed(r1)), name)
def roof_drop(a, side):
    # a = horizontal distance from the ridge. side +1 = front (toward +Z, carries the porch), -1 = back.
    # Concave : steep at the ridge, flat at the eave, measured power 1.45 on the side view.
    R = P('roof_porch_run') if side > 0 else P('roof_back_run')
    D = P('roof_porch_drop') if side > 0 else P('roof_back_drop')
    sN = min(1.0, max(0.0, a / R))
    return -D * (1.0 - (1.0 - sN) ** P('roof_curve_power')) + P('roof_eave_flare') * sN ** 8
def roof_pt(a, side):
    return hou.Vector3(0.0, roof_drop(a, side), side * a)
class RoofCurve:
    # arc length table of one side, so rows are spaced ALONG the curved surface
    def __init__(self, side, a_end, n=600):
        self.side = side; self.a = [a_end * i / float(n) for i in range(n + 1)]
        self.s = [0.0]
        for i in range(n):
            self.s.append(self.s[-1] + (roof_pt(self.a[i + 1], side) - roof_pt(self.a[i], side)).length())
    def a_at(self, target):
        s = self.s
        if target <= 0: return 0.0
        for i in range(len(s) - 1):
            if s[i + 1] >= target:
                f = (target - s[i]) / max(1e-9, s[i + 1] - s[i])
                return self.a[i] + f * (self.a[i + 1] - self.a[i])
        return self.a[-1]
    def frame(self, a):
        e = 0.002
        d = (roof_pt(a + e, self.side) - roof_pt(max(0.0, a - e), self.side)).normalized()   # down the slope
        n = hou.Vector3(0.0, abs(d[2]), self.side * abs(d[1])).normalized()                   # up and OUT of the roof
        return d, n
def field_half(width):
    # half width actually covered by whole tile columns : every edge piece aligns on it
    px = TW * P('roof_tile_scale')
    return int(width / px) * px / 2.0
def sweep_tube(pts, r, name, sides=12):
    # tube along a polyline lying in a YZ plane ; u stays on X so the rings never twist
    rings = []
    for i, c in enumerate(pts):
        t = (pts[min(i + 1, len(pts) - 1)] - pts[max(i - 1, 0)]).normalized()
        u = hou.Vector3(1.0, 0.0, 0.0); v = t.cross(u).normalized()
        ring = []
        for j in range(sides):
            ang = 2 * math.pi * j / sides
            q = geo.createPoint(); q.setPosition(c + (u * math.cos(ang) + v * math.sin(ang)) * r); ring.append(q)
        rings.append(ring)
    for i in range(len(rings) - 1):
        r0, r1 = rings[i], rings[i + 1]
        for j in range(sides):
            jj = (j + 1) % sides
            pl([r1[j], r1[jj], r0[jj], r0[j]], name)
    pl(rings[0], name); pl(list(reversed(rings[-1])), name)
TW = P('tile_width'); TL = P('tile_length'); TT = P('tile_thickness')
TC = P('tile_curve'); RR = P('tile_roll_radius'); SEG = int(P('tile_segments')); LUG = P('tile_lug')
TR = P('tile_trough'); RATIO = P('tile_rise_ratio')
LIPW = P('tile_lip_width'); LIPD = P('tile_lip_drop')
