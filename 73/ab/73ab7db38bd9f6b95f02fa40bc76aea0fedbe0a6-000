    aabb(xL - LUG * 1.1, yB0 - LIPD * 0.75, z0, xL + LUG * 0.4, yB0 - LIPD * 0.3, z1, 'tile_tab')
    aabb(cx + RR - LUG * 0.6, cy - RR * 0.3, z0, cx + RR + LUG * 1.1, cy + RR * 0.15, z1, 'tile_tab')
paint((0.74, 0.74, 0.73))
