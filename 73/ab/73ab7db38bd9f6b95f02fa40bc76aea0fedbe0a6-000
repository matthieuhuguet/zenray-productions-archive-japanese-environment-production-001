def ensure_parms(node):
    g = node.parmTemplateGroup()
    missing = [x for x in PARMS if g.find(x[0]) is None]
    if not missing:
        return
    folder = g.find('f_japan')
    f = hou.FolderParmTemplate('f_japan', 'Japan Scene', folder_type=hou.folderType.Tabs)
    for name, label, d, lo, hi in missing:
        if isinstance(d, str):
            f.addParmTemplate(hou.StringParmTemplate(name, label, 1, (d,)))
        elif isinstance(d, int):
            f.addParmTemplate(hou.IntParmTemplate(name, label, 1, (d,), min=lo, max=hi))
        else:
            f.addParmTemplate(hou.FloatParmTemplate(name, label, 1, (d,), min=lo, max=hi))
    if folder is None:
        g.append(f)
    else:
        for t in f.parmTemplates():
            g.appendToFolder(folder, t)
    node.setParmTemplateGroup(g)



def tidy(scene):
    """Lay the graph out and box each component so anything is found at a glance.
    FR : range le graphe, une boite par composant, une couleur par famille."""
    for b in scene.networkBoxes():
        b.destroy()
    for comp in scene.children():
        if not comp.name().startswith('Component_'):
            continue
        comp.setColor(hou.Color((0.35, 0.52, 0.72)))
        comp.setComment(comp.name().replace('Component_', ''))
        comp.setGenericFlag(hou.nodeFlag.DisplayComment, True)
        for sub in comp.children():
            if sub.name().startswith('Sub_'):
                sub.setColor(hou.Color((0.45, 0.68, 0.45)))
                sub.setComment(sub.name()[4:])
                sub.setGenericFlag(hou.nodeFlag.DisplayComment, True)
            sub.parent().layoutChildren()
        comp.layoutChildren()
        box = scene.createNetworkBox('box_' + comp.name())
        box.setComment(comp.name())
        box.addNode(comp)
    for helper in ('preview_tile', 'preview_tile_normals'):
        n = scene.node(helper)
        if n is not None:
            n.setColor(hou.Color((0.85, 0.65, 0.3)))
    scene.layoutChildren()


def build():
    obj = hou.node('/obj')
    scene = obj.node('JapanScene') or obj.createNode('geo', 'JapanScene')
    for c in scene.children():
        if c.type().name() == 'file':
            c.destroy()
    ensure_parms(scene)
    built = []
    for cid, name in IDS:
        full = 'Component_%s_%02d' % (name, cid)
        node = scene.node(full)
        if cid in BUILT:
            node = node or scene.createNode('subnet', full)
            for c in node.children():
                c.destroy()
            if cid in SUBS:
                mrg = node.createNode('merge', 'merge_subcomponents')
                for i_sub, (sname, scode) in enumerate(sorted(SUBS[cid].items())):
                    sub = node.createNode('subnet', 'Sub_' + sname)
                    if sname.endswith('_blockout'):
                        # superseded work : built and kept in the graph, but unplugged from the merge
                        spy = sub.createNode('python', 'build'); spy.parm('python').set(SHARED[cid] + scode)
                        so = sub.createNode('output', 'output0'); so.setInput(0, spy)
                        sub.setColor(hou.Color((0.4, 0.4, 0.4))); sub.layoutChildren()
                        continue
                    if sname.endswith('TileModule'):
                        # the tile is its own HDA, welded, stored in otls/ and instanced here.
                        # FR : la tuile est un HDA a part entiere, range dans otls/, simplement instancie.
                        hou.hda.installFile(TILE_HDA)
                        spy = sub.createNode('zenray_japanese_roof_tile', 'tile')
                        for tp in spy.parms():
                            if tp.name().startswith('tile_') and node.parent().parm(tp.name()) is not None:
                                tp.setExpression('ch("../../../%s")' % tp.name())
                        so = sub.createNode('output', 'output0'); so.setInput(0, spy)
                        sub.layoutChildren()
                        continue                # the source tile is instanced, never merged as geometry
                    spy = sub.createNode('python', 'build'); spy.parm('python').set(SHARED[cid] + scode)
                    last = spy
                    if sname.endswith('RoofField'):
                        # tiles are INSTANCED on the generated points, never placed by hand
                        om = sub.createNode('object_merge', 'in_tile_module')
                        om.parm('objpath1').set('../../Sub_09a_TileModule/output0')
                        cp = sub.createNode('copytopoints::2.0', 'copy_tiles_to_points')
                        cp.setInput(0, om); cp.setInput(1, spy)
                        cp.parm('pack').set(1)          # packed : thousands of tiles stay light
                        last = cp
                    if SUB_BEVEL[cid].get(sname, 0) > 0:
                        sb = sub.createNode('polybevel::3.0', 'rounded_edges'); sb.setInput(0, spy)
                        sb.parm('ignoreflatedges').set(1); sb.parm('flatangle').set(25)
                        sb.parm('offset').set(SUB_BEVEL[cid][sname]); sb.parm('divisions').set(2)
                        last = sb
                    so = sub.createNode('output', 'output0'); so.setInput(0, last)
                    sub.layoutChildren()
                    mrg.setInput(i_sub, sub)
                py = mrg
            else:
                py = node.createNode('python', 'build')
                py.parm('python').set(CODE[cid])
            nrm = node.createNode('normal', 'normals'); nrm.setInput(0, py)
            nrm.parm('type').set(1); nrm.parm('cuspangle').set(30)
            col = node.createNode('color', 'tint'); col.setInput(0, nrm)
            col.parm('class').set(1)
            col.parmTuple('color').set(COLORS.get(cid, (0.62, 0.62, 0.62)))
            out = node.createNode('output', 'output0'); out.setInput(0, col)
            node.layoutChildren()
            built.append(node)
        elif node is None:
            scene.createNode('subnet', full)
    plat = scene.node('Component_ShrinePlatform_11')
    if plat is not None:
        place = scene.node('place_platform_11') or scene.createNode('xform', 'place_platform_11')
        place.setInput(0, plat)
        for pn, src in (('tx', 'platform_place'), ('ty', 'platform_place_y'), ('tz', 'platform_place_z'), ('ry', 'platform_place_yaw')):
            place.parm(pn).setExpression('ch("../%s")' % src)
        built = [place if n.name() == plat.name() else n for n in built]
    lant = scene.node('Component_StoneLantern_14')
    if lant is not None:
        pair = []
        for side, sgn in (('l', -1), ('r', 1)):
            n = scene.node('place_lantern_14_' + side) or scene.createNode('xform', 'place_lantern_14_' + side)
            n.setInput(0, lant)
            n.parm('tx').setExpression('%d * ch("../prx_lantern_x")' % sgn)
            n.parm('tz').setExpression('ch("../prx_lantern_z")')
            pair.append(n)
        built = [x for x in built if x.name() != lant.name()] + pair
    tor = scene.node('Component_Torii_12')
    if tor is not None:
        place_t = scene.node('place_torii_12') or scene.createNode('xform', 'place_torii_12')
        place_t.setInput(0, tor)
        for pn, src in (('tx', 'torii_place_x'), ('ty', 'torii_place_y'), ('tz', 'torii_place_z'), ('ry', 'torii_place_yaw')):
            place_t.parm(pn).setExpression('ch("../%s")' % src)
        built = [place_t if n.name() == tor.name() else n for n in built]
    ent = scene.node('Component_Entrance_10')
    if ent is not None:
        place_e = scene.node('place_entrance_10') or scene.createNode('xform', 'place_entrance_10')
        place_e.setInput(0, ent)
        for pn, src in (('tx', 'ent_place_x'), ('ty', 'ent_place_y'), ('tz', 'ent_place_z'), ('ry', 'ent_place_yaw')):
            place_e.parm(pn).setExpression('ch("../%s")' % src)
        built = [place_e if n.name() == ent.name() else n for n in built]
    roof = scene.node('Component_Roof_09')
    if roof is not None:
        place_r = scene.node('place_roof_09') or scene.createNode('xform', 'place_roof_09')
        place_r.setInput(0, roof)
        for pn, src in (('tx', 'roof_place_x'), ('ty', 'roof_place_y'), ('tz', 'roof_place_z'), ('ry', 'roof_place_yaw')):
            place_r.parm(pn).setExpression('ch("../%s")' % src)
        built = [place_r if n.name() == roof.name() else n for n in built]
    merge = scene.node('merge_components') or scene.createNode('merge', 'merge_components')
    for i in range(len(merge.inputs())):
        merge.setInput(i, None)
    for i, n in enumerate(built):
        merge.setInput(i, n)
    out = scene.node('OUT_japan_v001') or scene.createNode('null', 'OUT_japan_v001')
    out.setInput(0, merge)
    out.setDisplayFlag(True); out.setRenderFlag(True)
    scene.layoutChildren()
